HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=40
MAX_IMAGE_SIDE=2048

DEFAULT_PROVIDER=qwen

# Main high-quality editing backend.
QWEN_MODEL_ID=Qwen/Qwen-Image-Edit-2511
QWEN_QUANTIZATION=nf4
QWEN_OFFLOAD=model
QWEN_STEPS=40
QWEN_TRUE_CFG_SCALE=4.0

# Unified generation + editing backend. Also powers "Create from scratch".
FLUX_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
FLUX_QUANTIZATION=none
FLUX_OFFLOAD=none
FLUX_STEPS=4

LOCAL_PADDING=128
MASK_FEATHER=10
LOCAL_MIN_SIDE=512
LOCAL_MAX_SIDE=1536
HF_TOKEN=
