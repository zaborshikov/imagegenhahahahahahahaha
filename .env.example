HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=40
MAX_IMAGE_SIDE=2048

# Editing backend used when the UI does not pick one: qwen21 | flux
DEFAULT_PROVIDER=qwen21
# Text-to-image backend for "Create from scratch": qwen21 | flux
DEFAULT_GENERATE_PROVIDER=qwen21
# GPU memory strategy (overridable per request from the UI): off | ram | disk
#   off  - everything resident on the GPU (fastest, needs the most VRAM)
#   ram  - components swapped GPU<->CPU one at a time
#   disk - text encoder and transformer+VAE never coexist; embeddings go through a temp file
DEFAULT_SAVE_GPU=off

# Qwen-Image-2.1: unified generation + editing (7B DiT + 8B Qwen3-VL text encoder).
# Quantization: none (bf16, ~31 GB) | fp8 (~16 GB, recommended) | nf4 | int8 (bitsandbytes)
QWEN21_MODEL_ID=Qwen/Qwen-Image-2.1
QWEN21_QUANTIZATION=fp8
QWEN21_OFFLOAD=none
QWEN21_STEPS=40
QWEN21_MIN_STEPS=4
QWEN21_MAX_STEPS=60
QWEN21_TRUE_CFG_SCALE=1.0
QWEN21_EDIT_RESOLUTION=1024

# FLUX.2 klein 4B: distilled, fast generation + editing.
FLUX_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
FLUX_QUANTIZATION=fp8
FLUX_OFFLOAD=none
FLUX_STEPS=4
FLUX_MIN_STEPS=1
FLUX_MAX_STEPS=12

LOCAL_PADDING=128
MASK_FEATHER=10
LOCAL_MIN_SIDE=512
LOCAL_MAX_SIDE=1536
HF_TOKEN=
