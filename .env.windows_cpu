HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=40
MAX_IMAGE_SIDE=1536

# CPU-only laptop: FLUX.2 klein is the only realistic backend.
DEFAULT_PROVIDER=flux
DEFAULT_GENERATE_PROVIDER=flux
DEFAULT_SAVE_GPU=off

# Qwen-Image-2.1 on CPU is experimental and very slow. fp8 storage halves RAM (~16 GB).
QWEN21_MODEL_ID=Qwen/Qwen-Image-2.1
QWEN21_QUANTIZATION=fp8
QWEN21_OFFLOAD=none
QWEN21_STEPS=20
QWEN21_MIN_STEPS=4
QWEN21_MAX_STEPS=40
QWEN21_TRUE_CFG_SCALE=1.0
QWEN21_EDIT_RESOLUTION=768

# Recommended local CPU backend.
FLUX_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
FLUX_QUANTIZATION=none
FLUX_OFFLOAD=none
FLUX_STEPS=4
FLUX_MIN_STEPS=1
FLUX_MAX_STEPS=8

LOCAL_PADDING=64
MASK_FEATHER=8
LOCAL_MIN_SIDE=384
LOCAL_MAX_SIDE=768
HF_TOKEN=
