HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=40
MAX_IMAGE_SIDE=1536
DEFAULT_PROVIDER=flux

# Qwen on a 32 GB CPU laptop is experimental and must be quantized.
QWEN_MODEL_ID=Qwen/Qwen-Image-Edit-2511
QWEN_QUANTIZATION=nf4
QWEN_OFFLOAD=none
QWEN_STEPS=20
QWEN_TRUE_CFG_SCALE=4.0

# Recommended local CPU backend.
FLUX_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
FLUX_QUANTIZATION=none
FLUX_OFFLOAD=none
FLUX_STEPS=4

LOCAL_PADDING=64
MASK_FEATHER=8
LOCAL_MIN_SIDE=384
LOCAL_MAX_SIDE=768
HF_TOKEN=
