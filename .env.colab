# Safe starting point for a Colab NVIDIA T4 (16 GB).
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=40
MAX_IMAGE_SIDE=1536
DEFAULT_PROVIDER=flux

# Qwen is much heavier. Keep it quantized + offloaded when you choose it.
QWEN_MODEL_ID=Qwen/Qwen-Image-Edit-2511
QWEN_QUANTIZATION=nf4
QWEN_OFFLOAD=model
QWEN_STEPS=30
QWEN_TRUE_CFG_SCALE=4.0

# FLUX.2 klein 4B is the reliable T4 starting backend and text-to-image generator.
FLUX_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
FLUX_QUANTIZATION=none
FLUX_OFFLOAD=none
FLUX_STEPS=4

LOCAL_PADDING=96
MASK_FEATHER=10
LOCAL_MIN_SIDE=512
LOCAL_MAX_SIDE=1024
HF_TOKEN=
