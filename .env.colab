# Safe starting point for a Colab NVIDIA T4 (16 GB VRAM, ~12 GB RAM).
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=40
MAX_IMAGE_SIDE=1536

DEFAULT_PROVIDER=flux
DEFAULT_GENERATE_PROVIDER=flux
# Qwen-Image-2.1 in fp8 is ~16 GB of weights: on a T4 it only fits in "disk" mode
# (text encoder and transformer are never on the GPU at the same time).
DEFAULT_SAVE_GPU=disk

QWEN21_MODEL_ID=Qwen/Qwen-Image-2.1
QWEN21_QUANTIZATION=fp8
QWEN21_OFFLOAD=none
QWEN21_STEPS=30
QWEN21_MIN_STEPS=4
QWEN21_MAX_STEPS=50
QWEN21_TRUE_CFG_SCALE=1.0
QWEN21_EDIT_RESOLUTION=1024

# FLUX.2 klein 4B in fp8 (~4 GB) is the reliable T4 backend.
FLUX_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
FLUX_QUANTIZATION=fp8
FLUX_OFFLOAD=none
FLUX_STEPS=4
FLUX_MIN_STEPS=1
FLUX_MAX_STEPS=12

LOCAL_PADDING=96
MASK_FEATHER=10
LOCAL_MIN_SIDE=512
LOCAL_MAX_SIDE=1024
HF_TOKEN=
